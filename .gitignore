# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Streamlit cache (but keep config files)
.streamlit/cache/
.streamlit/secrets.toml

# Editors & tooling
.vscode/
.idea/
.claude/
.agents/

# Exploration notebooks (use scripts/ instead)
/notebooks/

# Data: proprietary measurement data — ignore contents, keep the README maps
/data/**
!/data/README.md
!/data/*/
!/data/*/README.md

# Local-only experiment code (anchored to repo root)
/scripts/

# Generated file types
*.xlsx
*.csv
*.log
*.png
# Keep logo assets tracked (override the *.png ignore above)
!app/assets/*.png

# Local notes & misc
claude.md
agents.md
AGENTS.md
.DS_Store
Thumbs.db
src/lysosense/facs/
